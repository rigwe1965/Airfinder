FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET=change-me
DATABASE_URL=sqlite:///airfinder.db
PUBLIC_BASE_URL=http://localhost:5000
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Optional settings. The commented lines show each default; uncomment to change. ----
# backend/tests/test_env_example.py fails when the code reads a variable that is not listed in this file.

# Revenue: applied to every fare
# DEFAULT_MARKUP_PERCENT=8
# DEFAULT_SERVICE_FEE_USD=15
# DEFAULT_COMMISSION_PERCENT=3

# Bookings must carry a server-signed fare quote. false is an emergency switch only.
# QUOTE_ENFORCE=true

# Mail server (with MAIL_USERNAME and MAIL_PASSWORD above)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_DEFAULT_SENDER=Airfinder <noreply@airfinder.com>

# Web server and network
# PORT=5000                                        # run.py only
# ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000   # comma-separated; browsers allowed to call /api
# TRUSTED_PROXY_COUNT=0                            # reverse proxies in front (Render alone = 1, Cloudflare + Render = 2)
# RATELIMIT_STORAGE_URI=memory://                  # shared store (e.g. redis://...) when running several workers
